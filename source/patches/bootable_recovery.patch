+// Recovery B must select and verify the next boot slot for both GUI and CLI.
+// The service performs the write; this code only reads misc and checks the
+// complete 1 MiB against the exact expected change, including CRC.
+bool TWFunc::Prepare_T40_Reboot(RebootCommand command) {
+    if (android::base::GetProperty("ro.t40.reboot_slot_policy", "") != "ab")
+        return true;
+    if (command != rb_current && command != rb_system && command != rb_recovery)
+        return true;
+    if (android::base::GetProperty("ro.boot.slot_suffix", "") != "_b") {
+        LOGERR("T40: refusing slot routing outside recovery B\n");
+        return false;
+    }
+    const unsigned target = command == rb_recovery ? 1 : 0;
+    android::base::unique_fd fd(open("/dev/block/by-name/misc", O_RDONLY | O_CLOEXEC));
+    uint64_t size = 0;
+    std::vector<uint8_t> before(1048576), expected, after(1048576);
+    if (fd < 0 || ioctl(fd, BLKGETSIZE64, &size) || size != before.size() ||
+        !android::base::ReadFullyAtOffset(fd, before.data(), before.size(), 0)) {
+        LOGERR("T40: unable to read expected misc device; reboot cancelled\n");
+        return false;
+    }
+    std::string error;
+    if (!t40::PrepareMisc(before, target, 1, &expected, &error)) {
+        LOGERR("T40: %s; reboot cancelled\n", error.c_str());
+        return false;
+    }
+    if (before != expected) {
+        using android::hardware::boot::V1_0::IBootControl;
+        using android::hardware::boot::V1_0::CommandResult;
+        auto hal = IBootControl::tryGetService();
+        if (hal == nullptr) {
+            LOGERR("T40: BootControl unavailable; reboot cancelled\n");
+            return false;
+        }
+        CommandResult result{};
+        auto ret = hal->setActiveBootSlot(target, [&result](const CommandResult& r) { result = r; });
+        if (!ret.isOk() || !result.success) {
+            LOGERR("T40: BootControl rejected slot; reboot cancelled\n");
+            return false;
+        }
+        sync();
+    }
+    if (!android::base::ReadFullyAtOffset(fd, after.data(), after.size(), 0) ||
+        after != expected) {
+        LOGERR("T40: misc readback differs from expected slot update; reboot cancelled\n");
+        return false;
+    }
+    LOGINFO("T40_ROUTE: slot %c verified, tries=6, full misc readback PASS\n",
+            target ? 'B' : 'A');
+    return true;
+}
+
 // reboot: Reboot the system. Return -1 on error, no return on success
 int TWFunc::tw_reboot(RebootCommand command)
 {
+	if (!Prepare_T40_Reboot(command)) return -1;
+	if (command == rb_recovery &&
+	    android::base::GetProperty("ro.t40.reboot_slot_policy", "") == "ab")
+		command = rb_system; // Boot the verified B image through normal boot.
 	DataManager::Flush();
 	Update_Log_File();
 
